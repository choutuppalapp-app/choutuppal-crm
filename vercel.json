{
  "version": 2,
  "builds": [
    {
      "src": "core/public/index.php",
      "use": "vercel-php@0.6.0",
      "config": {
        "version": "8.2.0"
      }
    }
  ],
  "routes": [
    { "src": "/build/(.*)", "dest": "/core/public/build/$1" },
    { "src": "/assets/(.*)", "dest": "/core/public/assets/$1" },
    { "src": "/(.*)", "dest": "/core/public/index.php" }
  ]
}
